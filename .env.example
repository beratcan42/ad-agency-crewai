# =================================================================
# CrewAI Multi-Agent Reklam Ajansi - Environment Variables
# =================================================================
# Bu dosya SABLON'dur. Gercek degerler .env icinde olmali.
# .env dosyasi .gitignore'da, ASLA commit etmeyin.
# =================================================================

# --- Proje Genel -------------------------------------------------
PROJECT_NAME=ad-agency
COMPOSE_PROJECT_NAME=adagency
ENV=development
TZ=Europe/Istanbul
LOG_LEVEL=INFO

# --- Postgres (pgvector) -----------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agency
POSTGRES_USER=agency
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql://agency:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/agency

# --- Redis -------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/2

# --- LLM Providers (Asama 0 sonu doldurulur) ---------------------
OPENROUTER_API_KEY=
GOOGLE_GEMINI_API_KEY=
HUGGINGFACE_TOKEN=

# --- Ollama (host'taki kurulum) ----------------------------------
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=qwen3.5:9b

# --- Vault (Google Drive senkron klasoru) ------------------------
# Windows host path (Docker Desktop kabul eder)
VAULT_BASE_PATH_HOST=D:\Google_Drive\AjansKlasoru
# Container icindeki mount yolu
VAULT_BASE_PATH=/vaults

# --- Agency API --------------------------------------------------
# Host portu .env'de 8010 (default 8000 Windows tarafinda baska bir servis
# tarafindan tutulmus olabilir). Container ici hep 8000.
AGENCY_API_HOST=0.0.0.0
AGENCY_API_PORT=8010
UVICORN_WORKERS=5
AGENCY_API_BASE_URL=http://localhost:8010

# --- CRM Service -------------------------------------------------
CRM_API_PORT=8001

# --- Flowise -----------------------------------------------------
FLOWISE_PORT=3000
FLOWISE_USERNAME=admin
FLOWISE_PASSWORD=CHANGE_ME_FLOWISE_PASSWORD

# --- Langfuse ----------------------------------------------------
LANGFUSE_PORT=3001
LANGFUSE_SECRET=CHANGE_ME_LANGFUSE_SECRET
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Postiz (sosyal medya) ---------------------------------------
POSTIZ_PORT=5000
POSTIZ_JWT_SECRET=CHANGE_ME_POSTIZ_JWT_SECRET
POSTIZ_DB_PASS=CHANGE_ME_POSTIZ_DB_PASS
POSTIZ_API_KEY=
POSTIZ_MAIN_URL=http://127.0.0.1:5000

# --- MCP Gateway -------------------------------------------------
MCP_GATEWAY_PORT=8811

# --- Gotenberg (PDF) ---------------------------------------------
GOTENBERG_PORT=3010

# --- Sandbox Runner ----------------------------------------------
SANDBOX_MEM_LIMIT=512m
SANDBOX_CPU_LIMIT=0.5

# --- Guardrails --------------------------------------------------
CREW_MAX_ITER=10
CREW_MAX_EXECUTION_TIME=300
CREW_MAX_RPM=20
TOKEN_BUDGET_PER_CAMPAIGN=100000
TOKEN_BUDGET_DAILY_GLOBAL=500000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT_SEC=300

# --- Vault Watcher -----------------------------------------------
VAULT_WATCHER_ENABLED=true
WATCHER_POLLING_INTERVAL=5.0
# Eski (yoksayilir): WATCHER_USE_POLLING=true
