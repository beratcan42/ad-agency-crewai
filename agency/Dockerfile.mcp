FROM python:3.12-slim

WORKDIR /app

# Sistem bagimliliklari
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# MCP icin temel gereksinimler
RUN pip install --no-cache-dir fastapi uvicorn mcp httpx

# Uygulama kodlari
COPY src/ ./src/

# MCP Gateway calistir (FastAPI uzerinde SSE veya stdio)
CMD ["uvicorn", "src.mcp_gateway.server:app", "--host", "0.0.0.0", "--port", "8811"]
